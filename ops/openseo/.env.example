# Base64 of the DataForSEO API login:password (not the account password).
# Set locally; never commit real credentials.
DATAFORSEO_API_KEY=
# Optional SAM assistant. Unnecessary for technical crawling.
OPENROUTER_API_KEY=
# Optional Google Search Console OAuth; configure all three together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
