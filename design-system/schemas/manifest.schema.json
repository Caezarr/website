{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonka-ai.com/design-system/schemas/manifest.schema.json",
  "title": "Wonka Design System Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "brandVersionId",
    "status",
    "principles",
    "themes",
    "channels",
    "sources",
    "generated",
    "interfaces",
    "governance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "brandVersionId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "beta", "stable", "deprecated", "retired"]
    },
    "releasedAt": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "selector", "status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "selector": { "type": "string" },
          "status": { "enum": ["beta", "stable", "deprecated"] }
        }
      }
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["product", "website", "campaign", "presentation"]
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "generated": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "interfaces": { "type": "object" },
    "governance": { "type": "object" }
  }
}
