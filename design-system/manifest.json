{
  "$schema": "./schemas/manifest.schema.json",
  "schemaVersion": "1.0.0",
  "id": "wonka-design-system",
  "name": "Wonka Design System",
  "version": "0.1.0",
  "brandVersionId": "wonka-brand-v0.1.0",
  "status": "beta",
  "releasedAt": "2026-08-03",
  "description": "The canonical brand and interface system for Wonka products, campaigns, presentations, and agent-generated artifacts.",
  "principles": [
    {
      "id": "sovereign-clarity",
      "name": "Sovereign clarity",
      "description": "Make complex enterprise AI feel controlled, legible, and calm."
    },
    {
      "id": "editorial-precision",
      "name": "Editorial precision",
      "description": "Pair an editorial display voice with disciplined product typography."
    },
    {
      "id": "useful-motion",
      "name": "Useful motion",
      "description": "Motion explains state and hierarchy; it never competes with the task."
    },
    {
      "id": "machine-readable",
      "name": "Machine-readable by default",
      "description": "Every approved rule has a stable identifier, version, description, and structured representation."
    }
  ],
  "themes": [
    {
      "id": "light",
      "label": "Light",
      "selector": "[data-theme=\"light\"]",
      "status": "stable"
    },
    {
      "id": "dark",
      "label": "Dark",
      "selector": "[data-theme=\"dark\"]",
      "status": "stable"
    }
  ],
  "channels": [
    "product",
    "website",
    "campaign",
    "presentation"
  ],
  "sources": {
    "tokens": "design-system/tokens/wonka.tokens.json",
    "components": "design-system/components.json",
    "assets": "design-system/assets.json"
  },
  "generated": {
    "css": "src/styles/generated/tokens.css",
    "typescript": "src/design-system/generated/tokens.ts",
    "tokenCatalog": "public/design-system/tokens.json",
    "componentCatalog": "public/design-system/components.json",
    "assetCatalog": "public/design-system/assets.json",
    "manifest": "public/design-system/manifest.json",
    "agentGuide": "public/design-system/llms.txt",
    "discovery": "public/.well-known/design-system.json"
  },
  "interfaces": {
    "storybook": {
      "script": "bun run storybook",
      "buildScript": "bun run storybook:build"
    },
    "agentCli": {
      "script": "bun run ds:query --",
      "commands": [
        "manifest",
        "tokens",
        "token <id> [--theme light|dark]",
        "components",
        "component <id>",
        "assets",
        "asset <id>",
        "search <query>"
      ]
    }
  },
  "governance": {
    "lifecycle": [
      "draft",
      "beta",
      "stable",
      "deprecated",
      "retired"
    ],
    "breakingChangesRequireMajorVersion": true,
    "humanApprovalRequired": true,
    "rawValuesAllowedInConsumers": false
  }
}
