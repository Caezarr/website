# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Site URL (used for sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://example.com

# Sanity write token (for seeding scripts, server-side live revalidation, hero lead capture)
SANITY_API_WRITE_TOKEN=

# Optional Cloudflare Turnstile for hero lead forms (set both keys together in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional read-only token for live preview in the browser (Viewer role)
SANITY_API_READ_TOKEN=

# Requesty (OpenAI-compatible Responses API)
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1
REQUESTY_AGENT_BLUEPRINT_MODEL=

# Private benchmark retrieval (Azure AI Search)
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=wonka-use-cases
AZURE_AI_SEARCH_API_VERSION=2025-09-01
AZURE_AI_SEARCH_SEMANTIC_CONFIGURATION=agent-blueprint

# Google Tag Manager is configured in src/app/layout.tsx

# PostHog EU product analytics (public project key, never a personal API key)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# France meeting URL (optional, for /france funnel)
NEXT_PUBLIC_FRANCE_MEETING_URL=

# Agent library: signs the expiring WonkaChat import ids issued by
# POST /api/agent-library/import (HMAC-SHA256). Long random value, e.g.
# `openssl rand -base64 48`. Required in production (and Vercel previews):
# without it the import API returns 503 and pages show the Blueprint CTA
# instead of "Import into WonkaChat". Rotating it invalidates ids already issued.
AGENT_LIBRARY_EXPORT_SECRET=

# Optional server-to-server auth for agent library exports
# (GET /api/agent-blueprint/<library id>/wonkachat). When set, WonkaChat must
# send `Authorization: Bearer <token>` or the export answers 404. Leave empty
# until WonkaChat sends the header. Blueprint assessment exports never require it.
WONKACHAT_EXPORT_TOKEN=
